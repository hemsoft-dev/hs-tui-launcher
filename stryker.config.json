{
  "$schema": "./scripts/mutation-tools/node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["pi/jev-decide/jev-core.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --import ./scripts/mutation-tools/offline.mjs --experimental-strip-types --test pi/jev-decide/*.test.ts"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 5000,
  "cleanTempDir": "always",
  "reporters": ["clear-text", "json"],
  "clearTextReporter": {
    "reportMutants": false,
    "reportTests": false
  },
  "jsonReporter": {
    "fileName": "mutation-artifacts/typescript/stryker.json"
  },
  "thresholds": {
    "high": 100,
    "low": 0,
    "break": null
  }
}
