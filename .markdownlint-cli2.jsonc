{
  "config": {
    "default": true,
    // Commands, research citations, and prose contain meaningful long lines.
    "MD013": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    // Stryker copies source into disposable mutation sandboxes.
    ".stryker-tmp/**",
    // bin is gitignored and contains only generated, third-party tool caches.
    "bin/**",
  ],
}
